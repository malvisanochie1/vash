# Server
PORT=4000
NODE_ENV=development
CORS_ORIGINS=*

# Auth — use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Payments — bank transfer destination (shown to customers at checkout)
PAYOUT_BANK_NAME=
PAYOUT_ACCOUNT_NAME=
PAYOUT_ACCOUNT_NUMBER=

# Card payments (Paystack). Leave empty to run card payments in sandbox mode.
PAYSTACK_SECRET_KEY=
