{
  "expo": {
    "name": "Vash",
    "slug": "velora-hair",
    "scheme": "velora",
    "version": "1.2.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.velorahair.app"
    },
    "android": {
      "package": "com.velorahair.app",
      "adaptiveIcon": {
        "backgroundColor": "#E0217A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 140,
          "backgroundColor": "#FFF8FB"
        }
      ],
      "expo-image",
      "expo-audio",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Vash to use Face ID to unlock your account."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "9b28d41b-83e5-4c9c-a02a-08c26f3a4b9a"
      }
    },
    "owner": "malvis",
    "updates": {
      "url": "https://u.expo.dev/9b28d41b-83e5-4c9c-a02a-08c26f3a4b9a"
    }
  }
}
